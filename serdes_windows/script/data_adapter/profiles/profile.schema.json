{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openketupa.local/schemas/data-profile-v1.json",
  "title": "OpenKetupa Data Adapter Profile",
  "type": "object",
  "required": ["schema_version", "id", "version"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "builtin": {"type": "boolean"},
    "extends": {"type": "string", "minLength": 1},
    "approval": {
      "type": "object",
      "properties": {
        "status": {"enum": ["draft", "approved"]},
        "approved_by": {"type": "string"},
        "approved_utc": {"type": "string"}
      },
      "additionalProperties": true
    },
    "columns": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1}
      }
    },
    "family_rules": {"type": "object"},
    "network_contracts": {"type": "object"},
    "endpoint_rules": {"type": "array"},
    "endpoint_order_rules": {"type": "array"},
    "component_role_rules": {"type": "array"}
  },
  "additionalProperties": true
}
