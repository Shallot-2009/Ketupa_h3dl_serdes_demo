{
  "schema_version": 1,
  "id": "serdes-pkg",
  "technology": "serdes",
  "topology": "pkg",
  "entrypoint": "modules/workflow/serdes_pkg.py",
  "preprocess": "script/00_Preprocess.py",
  "inputs": {
    "layout": [
      ".mcm",
      ".sip"
    ],
    "netlist": [
      ".xlsx",
      ".xlsm",
      ".csv"
    ],
    "stackup": [
      ".xml",
      ".py"
    ]
  },
  "modes": {
    "0": "build_validate_save",
    "1": "build_solve_export"
  },
  "network_contract": "SDS + RX/TX + lane + P/N",
  "placement_contract": {
    "column_b": "BGA",
    "column_c": "C4",
    "placement_file": "not_required"
  },
  "reports": [
    "SDD11",
    "SDD22",
    "SDD21",
    "differential_TDR",
    "PN_skew"
  ],
  "markers_ghz": [
    28,
    56
  ],
  "geometry": {
    "cutout": "1mm"
  },
  "output_contract": {
    "project_label": "KETUPA_H3DL_SERDES_PKG",
    "design_prefix": "SERDES_PKG_CHANNEL",
    "task_root": "output/serdes_pkg/<action_task_id>",
    "projects": "output/serdes_pkg/<action_task_id>/h3d_projects",
    "parallel_projects": "output/serdes_pkg/<action_task_id>/h3d_projects/parallel_workers/<model>",
    "results": "output/serdes_pkg/<action_task_id>/results",
    "parallel_results": "output/serdes_pkg/<action_task_id>/results/parallel_workers/<model>",
    "automatic_sparameter_export": "output/S-parameter_Export/<workflow>/<action_task_id>/<design>",
    "result_layout": {
      "s_parameters": "s_parameters/*.sNp",
      "report_csv": "reports/csv/*.csv",
      "report_bmp": "reports/bmp/*.bmp",
      "summaries": "summaries/",
      "manifests": "manifests/*.json"
    },
    "logs": "output/serdes_pkg/<action_task_id>/logs/global/workflow.log",
    "log_layout": {
      "resources": "logs/global/resource_allocation.json",
      "worker": "logs/models/<model>/worker.log",
      "aggregate": "logs/all.log",
      "summary": "logs/summary.log"
    }
  },
  "author": {
    "name": "hongbo.li",
    "emails": [
      "asenjoaupa@gmail.com",
      "3405802009@qq.com"
    ]
  }
}
